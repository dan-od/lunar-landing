#!/bin/sh
# Reference copy only. The active hook lives at .git/hooks/commit-msg and is the
# one git runs; this tracked copy exists so the rule is visible in history.
# It strips any AI-attribution lines from commit messages (see AGENTS.md).
grep -viE '^co-authored-by:|generated with|claude\.ai/code|noreply@anthropic' "$1" > "$1.tmp"
mv "$1.tmp" "$1"
