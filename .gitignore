# data: the 181 MB LOLA elevation map is never committed. "/data" covers both
# the folder and a symlink of that name (a worktree links to the one copy).
/data

# dependencies
node_modules/

# build output
dist/
build/
*.tsbuildinfo

# env and secrets (never commit real values)
.env
.env.*
!.env.example

# logs and os cruft
*.log
npm-debug.log*
.DS_Store

# test/coverage
coverage/
tools/terrain/.venv/
tools/terrain/out/

# Claude Code: only shared config is committed (.claude/settings.json,
# .claude/launch.json, commands/, agents/, skills/). Never the rest:
.claude/worktrees/
.claude/settings.local.json
.claude/*.local.*
CLAUDE.local.md
.claude/memory/
.claude/projects/
.claude/todos/
.claude/history*
.claude/logs/
.claude/cache/
.claude/shell-snapshots/
.claude/statsig/
.claude/plans/
