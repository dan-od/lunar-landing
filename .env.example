# Moon Status deployment settings. Copy to .env for local dev.
# No real secret values live in the repository; production values come from
# the deployment pipeline's secrets at deploy time (see AGENTS.md).

# --- Server ---
PORT=8080
NODE_ENV=development

# --- Database (PostgreSQL) ---
# The server owns the cache, sites, watches and events tables.
DATABASE_URL=postgres://moon:moon@localhost:5432/moonstatus
# Deployments do not use DATABASE_URL: docker-compose.yml passes PGHOST, PGUSER,
# PGPASSWORD and PGDATABASE to the server instead, built from the values below.
# Used by docker-compose to initialise the database container.
POSTGRES_USER=moon
POSTGRES_PASSWORD=change-me-in-deployment
POSTGRES_DB=moonstatus

# --- NASA Horizons ---
# Base URL for the JPL Horizons API. Called server-side only, one at a time.
HORIZONS_API_URL=https://ssd.jpl.nasa.gov/api/horizons.api
# Per-request timeout and bounded retries with increasing waits.
HORIZONS_TIMEOUT_MS=30000
HORIZONS_MAX_RETRIES=3
HORIZONS_RETRY_BASE_MS=1000

# --- Public site address (used for links in emails/share, SEO canonical) ---
PUBLIC_SITE_URL=http://localhost:8080

# --- Email alerts (flow 5: watch by email) ---
# Alerts are ON only when both secrets below are set and a database is
# configured; otherwise the watch endpoints answer "not switched on" and no
# daily check runs. Named only: the values are deployment secrets, never
# written in this file.
# EMAIL_SENDING_KEY=        (key for the email service, Resend)
# TOKEN_SIGNING_SECRET=     (long random text; keys the stored hashes of watch links)
# The From line of alert emails (default: Moon Status <moon@okoro.me>).
# EMAIL_FROM=
# New watches one visitor may start per hour (default 5).
# WATCHES_PER_HOUR=
# All watch data is removed once the UTC date is past this day, 30 days after
# the event (default 2026-12-15).
# WATCH_DATA_DELETE_AFTER=
# Local development only: the value "fake" (with TOKEN_SIGNING_SECRET set and
# NODE_ENV not "production") turns alerts on with a sender that sends nothing
# and writes each message's links to the server log. Ignored in production.
# EMAIL_SENDER=

# --- Rate limiting (per visitor, every /v1 endpoint) ---
RATE_LIMIT_PER_MINUTE=120
# New custom coordinates a visitor may add per hour (each costs two NASA requests).
CUSTOM_SITES_PER_HOUR=5
# Dates not saved yet that a visitor may open per hour (each costs NASA requests).
NEW_PERIODS_PER_HOUR=12
# Which proxy hops to trust for the visitor address (Express "trust proxy").
TRUST_PROXY=loopback, linklocal, uniquelocal
