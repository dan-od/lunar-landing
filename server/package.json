{
  "name": "@moon/server",
  "version": "0.1.0",
  "description": "Express server: owns the cache, the calculator and all contact with NASA Horizons.",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/sites/seed.ts",
    "seed:cache": "tsx src/cache/seedCache.ts",
    "load:terrain": "tsx src/terrain/loadTerrain.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@moon/core": "*",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
